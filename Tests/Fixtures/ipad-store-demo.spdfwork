{"tables":[],"analysisKey":"f54c1473c4a9978c3f47eed5e40697ac4289bcb17a3ce1373062642cf8863a13","selectionMetadata":{"order":["f68f8db58aab828f87a41b4553d7ce9e591441c6f983b71718eff7b0db276534"],"statuses":{"f68f8db58aab828f87a41b4553d7ce9e591441c6f983b71718eff7b0db276534":"Bespreken"}},"chosenPassages":[],"viewState":{"pointsMode":"mine","section":"Mijn selectie","openTableIDs":[],"compactReading":false,"search":"onderhoud","reviewFilter":0,"openGroups":["Financiën","Overige onderwerpen"],"pdfVisible":true,"pointsExpanded":true,"committeeOpenCategories":{},"pointPageFilter":""},"highlightScope":"Hele document","focus":"","citationWarning":"","formatVersion":1,"committeeReviews":[],"summaryPages":[1],"insights":[{"summary":"Het college stelt voor de hoofdingang toegankelijker te maken.","question":"","passageID":"d158305267feb0009d2a95a00668f441feefc48282ff905de57db1e3a92d7482","passagePartIndex":1,"contextSources":[{"page":1,"quote":"DOEL EN VOORSTEL\nHet college stelt voor de hoofdingang van de openbare bibliotheek in Voorbeeldstad\ntoegankelijker te maken. "}],"otherSources":[],"relevanceReason":"Expliciet doel in CORE-document","quote":"Fictief voorbeeld – geen echt raadsvoorstel\n\nToegankelijke bibliotheek in Voorbeeldstad\nRaadsvoorstel · Commissie SOD · concept van 30 oktober 2026","page":1,"relevanceClass":"main","passageSources":[{"page":1,"quote":"Fictief voorbeeld – geen echt raadsvoorstel\n\nToegankelijke bibliotheek in Voorbeeldstad\nRaadsvoorstel · Commissie SOD · concept van 30 oktober 2026"}],"passagePartCount":1,"relevance":"","title":"Voorstel voor toegankelijkheid"},{"summary":"Het college stelt een voorstel op voor een toegankelijkere hoofdingang met automatische deur, looproute en routeborden.","question":"","passageID":"656bc76994bc081c954dd98045828fb8e36a1638f0f466dba825ec003ac87b02","passagePartIndex":1,"otherSources":[],"relevanceReason":"Document bevat expliciet voorstel en kosten.","quote":"DOEL EN VOORSTEL\nHet college stelt voor de hoofdingang van de openbare bibliotheek in Voorbeeldstad\ntoegankelijker te maken. Het plan omvat een automatische toegangsdeur, een voelbare en\ncontrasterende looproute naar de balie, en duidelijke routeborden. Dit is een voorstel ter\nbespreking; er is nog geen krediet toegekend en er is geen opdracht verstrekt.\nVOORGESTELDE UITGAVEN\n• Automatische deur en bediening: € 12.000\n\n• Voelbare looproute en contrastmarkering: € 6.500\n\n• Routeborden en plaatsing: € 3.500","page":1,"relevanceClass":"main","passageSources":[{"page":1,"quote":"DOEL EN VOORSTEL\nHet college stelt voor de hoofdingang van de openbare bibliotheek in Voorbeeldstad\ntoegankelijker te maken. Het plan omvat een automatische toegangsdeur, een voelbare en\ncontrasterende looproute naar de balie, en duidelijke routeborden. Dit is een voorstel ter\nbespreking; er is nog geen krediet toegekend en er is geen opdracht verstrekt.\nVOORGESTELDE UITGAVEN\n• Automatische deur en bediening: € 12.000\n\n• Voelbare looproute en contrastmarkering: € 6.500\n\n• Routeborden en plaatsing: € 3.500"}],"passagePartCount":1,"relevance":"","title":"Voorstel voor toegankelijkheid"},{"summary":"De raad beslist op 19 november 2026 over maximaal € 22.000.","question":"","passageID":"e271ea13cf07cfa8d21806d0b0fd54d821592538d82d33846cd3f12b62faccbe","passagePartIndex":1,"otherSources":[],"relevanceReason":"Document vermeldt expliciet besluit op specifieke datum en bedrag.","quote":"Totaal aangevraagd: € 22.000 inclusief btw. Dit zijn ramingen, geen offertes.\nGEVRAAGD BESLUIT EN VERANTWOORDELIJKHEID\nDe raad wordt gevraagd op 19 november 2026 te besluiten of maximaal € 22.000\nbeschikbaar wordt gesteld. Een positief besluit is nog geen opdracht aan een leverancier.\nNa goedkeuring is het college verantwoordelijk voor inkoop en uitvoering.\nTERMIJN, RISICO’S EN VOORWAARDEN\nBij goedkeuring levert het college uiterlijk 15 januari 2027 een uitvoerings- en\nonderhoudsplan aan de raad. De raming kan afwijken van de offertes. De ingang en\nvluchtroute moeten tijdens werkzaamheden bruikbaar blijven. Als de offertes samen boven\nhet aangevraagde bedrag uitkomen, vraagt het college eerst een nieuw raadsbesluit aan.\nDe uitvoering start pas na vaststelling van het budget en controle van de\ntoegankelijkheidsmaatregelen.\nBRONSTATUS\nBedragen zijn ramingen. Offertes, uitvoeringstoestemming en een raadsbesluit ontbreken\nnog. Dit document bevat uitsluitend broninformatie en geen AI-analyse.","page":1,"relevanceClass":"main","passageSources":[{"page":1,"quote":"Totaal aangevraagd: € 22.000 inclusief btw. Dit zijn ramingen, geen offertes.\nGEVRAAGD BESLUIT EN VERANTWOORDELIJKHEID\nDe raad wordt gevraagd op 19 november 2026 te besluiten of maximaal € 22.000\nbeschikbaar wordt gesteld. Een positief besluit is nog geen opdracht aan een leverancier.\nNa goedkeuring is het college verantwoordelijk voor inkoop en uitvoering.\nTERMIJN, RISICO’S EN VOORWAARDEN\nBij goedkeuring levert het college uiterlijk 15 januari 2027 een uitvoerings- en\nonderhoudsplan aan de raad. De raming kan afwijken van de offertes. De ingang en\nvluchtroute moeten tijdens werkzaamheden bruikbaar blijven. Als de offertes samen boven\nhet aangevraagde bedrag uitkomen, vraagt het college eerst een nieuw raadsbesluit aan.\nDe uitvoering start pas na vaststelling van het budget en controle van de\ntoegankelijkheidsmaatregelen.\nBRONSTATUS\nBedragen zijn ramingen. Offertes, uitvoeringstoestemming en een raadsbesluit ontbreken\nnog. Dit document bevat uitsluitend broninformatie en geen AI-analyse."}],"passagePartCount":1,"relevance":"","title":"Besluit over budget"},{"summary":"Het college levert uiterlijk 15 januari 2027 een plan.","question":"","passageID":"e271ea13cf07cfa8d21806d0b0fd54d821592538d82d33846cd3f12b62faccbe","passagePartIndex":1,"otherSources":[],"relevanceReason":"Deadline en verplichting voor planopstelling zijn vastgelegd.","quote":"Totaal aangevraagd: € 22.000 inclusief btw. Dit zijn ramingen, geen offertes.\nGEVRAAGD BE