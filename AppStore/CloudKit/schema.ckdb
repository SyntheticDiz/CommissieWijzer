DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE Dossier (
        dossierID   STRING,
        title       STRING,
        modifiedAt  TIMESTAMP,
        contentHash STRING,
        formatVersion INT64,
        archive     ASSET
    );

    RECORD TYPE CommitteeVersion (
        versionID     STRING,
        modifiedAt    TIMESTAMP,
        contentHash   STRING,
        formatVersion INT64,
        payload       ASSET
    );
